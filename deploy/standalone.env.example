# Learning Agent Hub 非 Docker 三端部署变量样板
# 复制到比赛目录根部并改名为 .env 后使用。这里只允许保留占位值，禁止写入真实密钥后提交或归档。

# ==================== 后端 ====================
SPRING_PROFILES_ACTIVE=api
SERVER_PORT=8080

# ==================== MySQL 8.0 ====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=learning_agent_hub
DB_USER=learning_agent_hub
DB_PASSWORD=change_me

# ==================== Redis ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== 本地文件存储 ====================
# 比赛包默认使用本地文件系统，不依赖 MinIO。请改成部署机器上的绝对路径。
FILE_STORAGE_PROVIDER=LOCAL
WORKFORCE_FILE_LOCAL_ROOT=/absolute/path/to/learning-agent-hub-data/files

# ==================== WebSocket 与异步任务 ====================
IM_WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=http://127.0.0.1:5173,http://127.0.0.1:5174
IM_OUTBOX_DISPATCHER_ENABLED=true
IM_OUTBOX_DISPATCHER_BATCH_SIZE=100
IM_OUTBOX_DISPATCHER_MAX_ATTEMPTS=5
IM_OUTBOX_DISPATCHER_RETRY_DELAY_MS=5000
IM_OUTBOX_DISPATCHER_SENDING_STALE_MS=60000
IM_OUTBOX_DISPATCHER_FIXED_DELAY_MS=3000
IM_OUTBOX_DISPATCHER_INITIAL_DELAY_MS=3000
AGENT_TIMEOUT_SCAN_ENABLED=true
AGENT_TIMEOUT_SCAN_BATCH_SIZE=100
AGENT_TIMEOUT_SCAN_FIXED_DELAY_MS=60000
AGENT_TIMEOUT_SCAN_INITIAL_DELAY_MS=60000

# ==================== 首次管理员 ====================
# 仅在全新数据库首次启动时临时改为 true；成功登录后必须改回 false 并重启。
EDUCATION_ADMIN_BOOTSTRAP_ENABLED=false
EDUCATION_ADMIN_LOGIN=
EDUCATION_ADMIN_PASSWORD=
EDUCATION_ADMIN_DISPLAY_NAME=教育运营管理员

# ==================== AI 模型（OpenAI 兼容） ====================
# 管理端没有可用默认文本模型时，系统回退到以下配置。
AGENT_MODEL_ENABLED=false
AGENT_MODEL_BASE_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=
AGENT_MODEL_TIMEOUT=30s
AGENT_MODEL_MAX_TOKENS=1024
AGENT_MODEL_TEMPERATURE=0.2

# ==================== RAG 向量库（按需启用） ====================
RAGFLOW_VECTOR_ENABLED=false
RAGFLOW_VECTOR_URL=
RAGFLOW_VECTOR_USERNAME=
RAGFLOW_VECTOR_PASSWORD=

# ==================== 邮件（按需启用） ====================
AUTH_EMAIL_VERIFY_ENABLED=false
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=noreply@learning-agent-hub.local
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
MAIL_HEALTH_ENABLED=false

# ==================== Office 只读预览 ====================
LIBREOFFICE_BIN=soffice
FILE_PREVIEW_TIMEOUT_SECONDS=120
FILE_PREVIEW_MAX_SOURCE_BYTES=104857600

# ==================== 数据库结构 ====================
# Flowable 表统一由 Flyway 管理，正式运行保持 false。
FLOWABLE_DB_SCHEMA_UPDATE=false
